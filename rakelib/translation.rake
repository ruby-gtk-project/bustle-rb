# frozen_string_literal: true

# Translation tasks: extract the catalogue template, and merge translations
# back into the data files that ship with the app.
#
# Ported from upstream's `make update-po` target and the intltool rules that
# turn data/*.in into the installed files. Upstream commits po/messages.pot
# and regenerates it from a make target; so does this.
#
# Rake loads everything in rakelib/, so these tasks are part of the Rakefile
# without the templated Rakefile itself having to change.

POT_PATH = "po/messages.pot"
DESKTOP_TEMPLATE = "data/org.rubygtkproject.Bustle.desktop.in"
DESKTOP_OUTPUT = "data/org.rubygtkproject.Bustle.desktop"
APPDATA_TEMPLATE = "data/org.rubygtkproject.Bustle.appdata.xml.in"
APPDATA_OUTPUT = "data/org.rubygtkproject.Bustle.appdata.xml"

# Which keys in the .desktop file are translatable, as upstream's intltool
# rules mark them.
DESKTOP_KEYS = %w[Name Comment Keywords].freeze

# The elements of the appdata file that hold translatable text.
APPDATA_ELEMENTS = %w[summary caption p].freeze

# One extracted message: the msgid and every place it was found.
PotEntry = Struct.new(:msgid, :locations)

# Finds `Bustle._("…")` call sites in Ruby sources. Adjacent string literals
# are one literal to the parser, so a message split across source lines comes
# out as the single msgid it is.
module MsgidExtractor
  class << self
    def from_ruby(paths)
      paths.flat_map { |path| calls_in(path) }
    end

    private

      def calls_in(path)
        node = RubyVM::AbstractSyntaxTree.parse_file(path)
        [].tap { |found| walk(node, path, found) }
      rescue SyntaxError
        []
      end

      def walk(node, path, found)
        if node.is_a?(RubyVM::AbstractSyntaxTree::Node)
          collect(node, path, found)
          node.children.each { |child| walk(child, path, found) }
        end
      end

      def collect(node, path, found)
        if translation_call?(node)
          literal_argument(node)&.then { |msgid| found << [msgid, "#{path}:#{node.first_lineno}"] }
        end
      end

      # `Bustle._("x")` is a CALL on the Bustle constant; `_("x")` inside the
      # module is an FCALL.
      def translation_call?(node)
        case node.type
        when :CALL then node.children[1] == :_
        when :FCALL then node.children[0] == :_
        else false
        end
      end

      def literal_argument(node)
        arguments_of(node).then do |arguments|
          arguments&.children&.first&.then do |first|
            if first.is_a?(RubyVM::AbstractSyntaxTree::Node) && first.type == :STR
              first.children.first
            end
          end
        end
      end

      def arguments_of(node)
        case node.type
        when :CALL then node.children[2]
        else node.children[1]
        end
      end
  end
end

# Pulls the translatable text out of the two data templates.
module DataExtractor
  class << self
    def from_desktop(path)
      File.readlines(path).each_with_index.filter_map do |line, index|
        key, value = line.chomp.split("=", 2)
        if DESKTOP_KEYS.include?(key) && value
          [value, "#{path}:#{index + 1}"]
        end
      end
    end

    def from_appdata(path)
      File.read(path).then do |source|
        APPDATA_ELEMENTS.flat_map { |element| texts_of(source, element, path) }
      end
    end

    private

      def texts_of(source, element, path)
        source.scan(%r{<#{element}>(.*?)</#{element}>}m).map do |match|
          [collapse(match.first), path]
        end
      end

      # Appdata text is indented in the file and is one paragraph to a
      # translator, which is how upstream's .pot holds it.
      def collapse(text) = text.gsub(/\s+/, " ").strip
  end
end

# Writes a gettext template.
module PotWriter
  HEADER = <<~HEADER
    # Translation template for Bustle.
    # Generated by `rake po:pot`; do not edit by hand.
    #
    #, fuzzy
    msgid ""
    msgstr ""
    "Project-Id-Version: bustle\\n"
    "MIME-Version: 1.0\\n"
    "Content-Type: text/plain; charset=UTF-8\\n"
    "Content-Transfer-Encoding: 8bit\\n"
  HEADER

  class << self
    def write(path, pairs)
      File.write(path, render(entries(pairs)))
      entries(pairs).length
    end

    def entries(pairs)
      pairs.group_by(&:first)
           .map { |msgid, found| PotEntry.new(msgid, found.map(&:last).uniq.sort) }
           .sort_by(&:msgid)
    end

    private

      def render(entries)
        ([HEADER] + entries.map { |entry| render_entry(entry) }).join("\n")
      end

      def render_entry(entry)
        <<~ENTRY
          #: #{entry.locations.join(" ")}
          msgid #{quote(entry.msgid)}
          msgstr ""
        ENTRY
      end

      # gettext writes a multi-line msgid as an empty first line followed by
      # one quoted line per newline-terminated chunk.
      def quote(msgid)
        escape(msgid).split("\\n", -1).then do |chunks|
          if chunks.length == 1
            "\"#{chunks.first}\""
          else
            multiline(chunks)
          end
        end
      end

      def multiline(chunks)
        chunks.each_with_index.map do |chunk, index|
          if index == chunks.length - 1
            "\"#{chunk}\""
          else
            "\"#{chunk}\\n\""
          end
        end.unshift("\"\"").join("\n")
      end

      def escape(text) = text.gsub("\\", "\\\\\\\\").gsub("\"", "\\\"").gsub("\n", "\\n")
  end
end

namespace :po do
  desc "Extract translatable strings into #{POT_PATH}"
  task :pot do
    sources = Dir["lib/**/*.rb"] + Dir["exe/*"]
    pairs = MsgidExtractor.from_ruby(sources.sort) +
      DataExtractor.from_desktop(DESKTOP_TEMPLATE) +
      DataExtractor.from_appdata(APPDATA_TEMPLATE)
    PotWriter.write(POT_PATH, pairs).then do |count|
      puts "#{POT_PATH}: #{count} messages"
    end
  end
end

namespace :data do
  desc "Merge translations into the desktop entry and the appdata file"
  task :merge do
    sh(
      "msgfmt",
      "--desktop",
      "--template=#{DESKTOP_TEMPLATE}",
      "-d",
      "po",
      "-o",
      DESKTOP_OUTPUT,
    )
    sh(
      "msgfmt",
      "--xml",
      "--template=#{APPDATA_TEMPLATE}",
      "-d",
      "po",
      "-o",
      APPDATA_OUTPUT,
    )
  end
end
